# ==============================================================================
# DocuMind Enterprise Document Intelligence - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL with pgvector in production, SQLite fallback in dev)
DATABASE_URL=sqlite:///./backend/documind.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://documind_user:documind_secure_password@localhost:5432/documind_db

# Redis Configuration (for Celery background tasks and caching)
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_documind_enterprise_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Configuration
# Server-side only: NEVER expose API keys in frontend code
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=text-embedding-004

# Document Upload & Processing Limits
MAX_UPLOAD_SIZE_MB=50
SUPPORTED_FILE_TYPES=pdf,docx,xlsx,csv,txt

# Compliance & Security
ZERO_RETENTION_POLICY=true
SOC2_COMPLIANCE_MODE=true
ENCRYPTION_STANDARD=AES-256-BYOK
